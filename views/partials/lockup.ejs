<%
  /* The brand lockup. The client supplies one horizontal logo, so this is a
     single image in two colourways rather than a mark plus live text.
     Pass `light: true` on dark surfaces for the keyed-out version. */
  var _light = typeof light !== 'undefined' && light;
  var _eager = typeof eager !== 'undefined' && eager;
%>
<img class="brand__logo"
     src="<%= _light ? site.logoLight : site.logo %>"
     width="<%= site.logoWidth %>" height="<%= site.logoHeight %>"
     alt="<%= site.name %> — <%= site.taglineShort %>"
     decoding="async"<% if (_eager) { %> fetchpriority="high"<% } %>>
