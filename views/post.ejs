<%
  var hero = Object.assign({}, post, {
    heroImage: post.image,
    heroImageAlt: post.imageAlt,
    h1: post.title,
    eyebrow: post.category,
    heroIntro: post.excerpt
  });
  var toc = post.blocks.filter(function (b) { return b.h2 && b.id; });
  var related = posts.filter(function (p) { return p.slug !== post.slug && p.category === post.category; });
  if (related.length < 3) {
    related = related.concat(posts.filter(function (p) { return p.slug !== post.slug && related.indexOf(p) === -1; }));
  }
  related = related.slice(0, 3);
  var shareUrl = encodeURIComponent(site.url + '/blog/' + post.slug);
  var shareTitle = encodeURIComponent(post.title);
%>
<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">
  <%- include('partials/page-hero', { hero: hero, crumbs: crumbs }) %>

  <section class="section section--tight">
    <div class="container container--narrow">
      <div class="byline reveal">
        <span class="byline__avatar" aria-hidden="true"><%= post.author.replace('Dr. ', '').charAt(0) %></span>
        <span class="byline__who">
          <strong><%= post.author %></strong>
          <small><%= post.authorRole %></small>
        </span>
        <span class="byline__meta">
          <time datetime="<%= post.date %>">Published <%= fmtDate(post.date) %></time>
          <% if (post.updated && post.updated !== post.date) { %>· Updated <time datetime="<%= post.updated %>"><%= fmtDate(post.updated) %></time><% } %>
          · <%= post.readTime %>
        </span>
      </div>

      <% if (post.tags && post.tags.length) { %>
      <ul class="chips chips--tight reveal">
        <% post.tags.forEach(function (t) { %><li class="chips__item"><%- icon('check-circle', 16) %><span><%= t %></span></li><% }); %>
      </ul>
      <% } %>

      <% if (toc.length > 2) { %>
      <nav class="toc reveal" aria-label="On this page">
        <p class="toc__label"><%- icon('file-text', 17) %> On this page</p>
        <ol class="toc__list">
          <% toc.forEach(function (t) { %><li><a href="#<%= t.id %>"><%= t.h2 %></a></li><% }); %>
        </ol>
      </nav>
      <% } %>
    </div>
  </section>

  <%- include('partials/blocks', { blocks: post.blocks }) %>

  <section class="section section--soft">
    <div class="container container--narrow">
      <div class="author-box reveal">
        <span class="author-box__avatar" aria-hidden="true"><%= post.author.replace('Dr. ', '').charAt(0) %></span>
        <div class="author-box__body">
          <p class="author-box__label">Written by</p>
          <h2 class="author-box__name"><%= post.author %></h2>
          <p class="author-box__role"><%= post.authorRole %>, <%= site.name %></p>
          <p class="author-box__text">This article was written by the team at <%= site.name %>. It is general information rather than advice for your particular trip, so tell us what you are planning and we will help you get it right.</p>
          <a class="btn btn--outline" href="/team"><%- icon('users', 18) %> Meet the team</a>
        </div>
      </div>

      <div class="share reveal">
        <p class="share__label">Share this article</p>
        <ul class="share__list">
          <li><a class="share__btn" href="https://www.facebook.com/sharer/sharer.php?u=<%= shareUrl %>" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook"><%- icon('facebook', 18) %></a></li>
          <li><a class="share__btn" href="https://x.com/intent/tweet?url=<%= shareUrl %>&text=<%= shareTitle %>" target="_blank" rel="noopener noreferrer" aria-label="Share on X"><%- icon('x-twitter', 18) %></a></li>
          <li><a class="share__btn" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= shareUrl %>" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn"><%- icon('linkedin', 18) %></a></li>
          <li><a class="share__btn" href="mailto:?subject=<%= shareTitle %>&body=<%= shareUrl %>" aria-label="Share by email"><%- icon('mail', 18) %></a></li>
        </ul>
      </div>
    </div>
  </section>

  <% if (related.length) { %>
  <section class="section">
    <div class="container">
      <header class="section__head reveal">
        <p class="eyebrow"><span class="eyebrow__ico"><%- icon('file-text', 15) %></span>Keep reading</p>
        <h2 class="section__title">More from the Journal</h2>
      </header>
      <ul class="post-grid">
        <% related.forEach(function (p, i) { %>
        <li class="post-card reveal" style="--d:<%= i * 70 %>ms">
          <a class="post-card__link" href="/blog/<%= p.slug %>">
            <span class="post-card__media">
              <%- imgTag(p.image, p.imageAlt || p.title, { sizes: '(min-width:1040px) 31vw, (min-width:700px) 47vw, 92vw', cls: 'post-card__img' }) %>
              <span class="post-card__cat"><%= p.category %></span>
            </span>
            <span class="post-card__body">
              <span class="post-card__meta"><time datetime="<%= p.date %>"><%= fmtDate(p.date) %></time> · <%= p.readTime %></span>
              <span class="post-card__title"><%= p.title %></span>
              <span class="post-card__excerpt"><%= p.excerpt %></span>
              <span class="post-card__more">Read article <%- icon('arrow-right', 16) %></span>
            </span>
          </a>
        </li>
        <% }); %>
      </ul>
      <p class="section__foot reveal"><a class="btn btn--outline" href="/blog">All articles <%- icon('arrow-right', 17) %></a></p>
    </div>
  </section>
  <% } %>

  <%- include('partials/cta', { cta: post.cta }) %>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
